{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri React Plotly",
  "version": "0.1.0",
  "identifier": "com.example.taurireactplotly",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tauri React Plotly",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
