{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri React Plotly",
  "version": "0.1.1",
  "identifier": "com.example.taurireactplotly",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Tauri React Plotly",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NTE4MjVGNTc5QUY0QUMKUldTczlKcFhYNEpSeFAzRGtiWUljVXZLWC9HY2ZGM3R4SGNhZndKRWxMVFlPc3ZxTlJhQ3B0Wm4K",
      "endpoints": [
        "https://github.com/Maleficas12/ElectronTest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
